# PostgreSQL + pgvector connection string (automatically configured in docker-compose.yml)
DATABASE_URL=postgresql://coach:coach@localhost:5432/coach_db
POSTGRES_USER=coach
POSTGRES_PASSWORD=coach
POSTGRES_DB=coach_db

# Optional: Set OPENAI_API_KEY to use live OpenAI Structured Outputs & text-embedding-3-small.
# Leave empty to use the deterministic MockCoachAdapter and 1536-d deterministic embedding fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
