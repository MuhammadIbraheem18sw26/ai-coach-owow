# PostgreSQL + pgvector connection string (automatically configured in docker-compose.yml)
DATABASE_URL=postgresql://coach:coach@localhost:5432/coach_db
POSTGRES_USER=coach
POSTGRES_PASSWORD=coach
POSTGRES_DB=coach_db

# Primary LLM & Embeddings (OpenAI ChatGPT + text-embedding-3-small)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Cross-Provider Fallback LLM (Google Gemini — automatically invoked if ChatGPT fails all retries)
GOOGLE_API_KEY=
GEMINI_API_KEY=
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
LLM_MAX_RETRIES=3

# Optional: Langfuse OpenTelemetry Observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
